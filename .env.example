# Environment variables

NODE_ENV=development

# Apps
WEB_PORT=48721
API_PORT=48722
NEXT_PUBLIC_API_URL=http://localhost:48722

# Database
DATABASE_URL=postgresql://delayance:delayance@localhost:58433/delayance

# Redis
REDIS_URL=redis://localhost:64380

# Keycloak (local development only)
KEYCLOAK_BASE_URL=http://localhost:58741
KEYCLOAK_ISSUER_URL=http://localhost:58741/realms/delayance
KEYCLOAK_REALM=delayance
KEYCLOAK_CLIENT_ID=delayance-api
KEYCLOAK_CLIENT_SECRET=dev-client-secret-change-me
KEYCLOAK_PROVISIONER_CLIENT_ID=delayance-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET=dev-provisioner-secret-change-me
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-now

# Google Gemini (server-side only; project creation works without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Encryption for stored secrets (32-byte hex = 64 hex chars)
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=59002
MINIO_ACCESS_KEY=delayance
MINIO_SECRET_KEY=delayance-secret
MINIO_BUCKET=delayance
MINIO_USE_SSL=false

# Collabora CODE development integration
OFFICE_ENABLED=true
OFFICE_DISCOVERY_URL=http://localhost:9980/hosting/discovery
OFFICE_BROWSER_URL=http://localhost:9980
WEB_ORIGIN=http://localhost:48721
# Address the API from the Collabora container, not from the browser.
WOPI_BASE_URL=http://host.docker.internal:48722
WOPI_TOKEN_TTL_SECONDS=28800
WOPI_LOCK_TTL_SECONDS=1800

# Rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Optional recovery email; reset links are not delivered without SMTP_HOST and SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
