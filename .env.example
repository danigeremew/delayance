# Environment variables

NODE_ENV=development

# Apps
WEB_PORT=48721
API_PORT=48722
NEXT_PUBLIC_API_URL=http://localhost:48722

# Database
DATABASE_URL=postgresql://delayance:delayance@localhost:58433/delayance

# Redis
REDIS_URL=redis://localhost:64380

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption for stored secrets (32-byte hex = 64 hex chars)
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=59002
MINIO_ACCESS_KEY=delayance
MINIO_SECRET_KEY=delayance-secret
MINIO_BUCKET=delayance
MINIO_USE_SSL=false

# Rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=20
