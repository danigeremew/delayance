# Environment variables

NODE_ENV=development

# Apps
WEB_PORT=48721
API_PORT=48722
NEXT_PUBLIC_API_URL=http://localhost:48722

# Local PostgreSQL (install pgvector for your PostgreSQL major version)
DATABASE_URL=postgresql://delayance:delayance@localhost:5432/delayance

# Redis
REDIS_URL=redis://localhost:64380


# Google Gemini (server-side only; project creation works without a key)
# Local authentication signing key; replace for any shared/production deployment.
AUTH_JWT_SECRET=dev-auth-secret-change-me-for-production

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Encryption for stored secrets (32-byte hex = 64 hex chars)
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local files (relative to repository root, or an absolute path)
STORAGE_DIR=storage
# Browser-reachable API URL used for expiring file download links
API_PUBLIC_URL=http://localhost:48722

# Wordcraft browser editor and shared WOPI save protocol
OFFICE_ENABLED=true
WORDCRAFT_BROWSER_URL=http://localhost:48721/wordcraft/index.html
WORDCRAFT_WOPI_BASE_URL=http://localhost:48722
WEB_ORIGIN=http://localhost:48721
WOPI_TOKEN_TTL_SECONDS=28800
WOPI_LOCK_TTL_SECONDS=1800

# Rate limiting
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Optional recovery email; reset links are not delivered without SMTP_HOST and SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
