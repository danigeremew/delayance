{
  "name": "@delayance/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@delayance/ai-core": "workspace:*",
    "@delayance/document-engine": "workspace:*",
    "@delayance/document-model": "workspace:*",
    "@delayance/docx-engine": "workspace:*",
    "@delayance/provider-adapters": "workspace:*",
    "@delayance/shared-types": "workspace:*",
    "@delayance/validation": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "bullmq": "^5.53.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@delayance/eslint-config": "workspace:*",
    "@delayance/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
